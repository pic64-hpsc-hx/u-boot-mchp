#include "p64h-hb130x.dts"

&mdio0 {
	phy0_2: ethernet-phy@2 {
		reg = <2>;
	};

	phy0_3: ethernet-phy@3 {
		reg = <3>;
	};
};

&gem2 {
	status = "okay";
	phy-handle = <&phy0_2>;
	phy-mode = "sgmii";
};

&gem3 {
	status = "okay";
	phy-handle = <&phy0_3>;
	phy-mode = "sgmii";
};
