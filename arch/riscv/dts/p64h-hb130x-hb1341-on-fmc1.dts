#include "p64h-hb130x.dts"

&mdio1 {
	phy2: ethernet-phy@2 {
		reg = <2>;
	};

	phy3: ethernet-phy@3 {
		reg = <3>;
	};
};

&gem0 {
	status = "okay";
	phy-handle = <&phy2>;
	phy-mode = "sgmii";
};

&gem1 {
	status = "okay";
	phy-handle = <&phy3>;
	phy-mode = "sgmii";
};
